# AgeGuard backend configuration
# Copy to .env and set your actual values.

SERVER_IP=192.168.1.100
FRONTEND_PORT=3000
BACKEND_PORT=5000
USE_HTTPS=true
SESSION_TTL_MINUTES=30

# Derived automatically if not set:
# FRONTEND_BASE_URL=https://192.168.1.100:3000

# Models are in backend/models/ — relative paths, no absolute paths needed.
# Required model files:
#   backend/models/age_resnet18_best.pth         (ResNet18 age estimator)
#   backend/models/best_model_quantized.onnx     (MiniFAS PAD/liveness)
#   backend/models/clip_ckpt_best.pth            (CLIP deepfake detector)
#   backend/models/face_detection_yunet.onnx     (YuNet face detector, auto-downloaded)
