REACT_APP_SERVER_IP=192.168.205.134
REACT_APP_FRONTEND_PORT=3000
REACT_APP_USE_HTTPS=true
REACT_APP_MOBILE_BASE_URL=https://192.168.205.134:3000

# For mobile QR + camera testing: npm run start:https
